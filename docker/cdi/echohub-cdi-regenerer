#!/usr/bin/env bash
# Régénère le spec CDI NVIDIA quand le numéro majeur de nvidia-uvm a changé.
#
# Panne mesurée le 2026-08-28 : le major de /dev/nvidia-uvm est assigné dynamiquement à chaque
# boot ; /etc/cdi/nvidia.yaml le fige au moment de sa génération, et Docker construit les nœuds
# du conteneur depuis ce fichier. Après un reboot où le major change, CUDA meurt dans le
# conteneur (« failed to initialize CUDA: unknown error ») et EchoHub ne charge plus rien.
# Ni `docker restart` ni `--force-recreate` seuls n'y font rien : il faut ce fichier à jour.
#
# Sortie : 0 = spec à jour (régénéré ou déjà bon), 3 = régénéré (utile pour forcer une
# recréation du conteneur), autre = échec.
set -euo pipefail
SPEC=/etc/cdi/nvidia.yaml

/sbin/modprobe nvidia_uvm 2>/dev/null || true
reel="$(awk '$2 == "nvidia-uvm" {print $1}' /proc/devices)"
[ -n "$reel" ] || { echo "[cdi] nvidia-uvm absent de /proc/devices" >&2; exit 1; }

fige="$(grep -A1 'path: /dev/nvidia-uvm$' "$SPEC" 2>/dev/null | awk '/major:/ {print $2}' || true)"
manquant=""
while read -r chemin; do
    [ -e "$chemin" ] || manquant="$chemin"
done < <(awk '$1 == "-" && $2 == "path:" && $3 ~ /^\/dev\// {print $3}' "$SPEC" 2>/dev/null | sort -u)
if [ -n "$manquant" ]; then
    echo "[cdi] device du spec absent : $manquant — régénération"
elif [ "$fige" = "$reel" ]; then
    echo "[cdi] spec à jour (nvidia-uvm major $reel)"
    exit 0
fi
echo "[cdi] major nvidia-uvm : spec=${fige:-absent}, réel=$reel — régénération"
nvidia-ctk cdi generate --output="$SPEC" >/dev/null 2>&1
nouveau="$(grep -A1 'path: /dev/nvidia-uvm$' "$SPEC" | awk '/major:/ {print $2}')"
[ "$nouveau" = "$reel" ] || { echo "[cdi] régénération incohérente : $nouveau ≠ $reel" >&2; exit 2; }
echo "[cdi] spec régénéré (major $nouveau)"
exit 3
